# File UTF-8. Copy thành TOMCAT_BASE/conf/keebforce-db.properties.
# File thật nằm ngoài WAR. CLI có thể dùng -Dkeebforce.db.config để chọn file khác.
# Database riêng cho requirement mới, tạo bằng các script trong database/.
db.url=jdbc:sqlserver://localhost:1433;databaseName=KeebForce_PRJ301;encrypt=true;trustServerCertificate=true
db.user=your_sql_login
db.password=your_local_password
# trustServerCertificate=true chỉ dành cho SQL Server local dùng chứng chỉ tự ký.
